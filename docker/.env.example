# =============================================================================
# docker/.env — o arquivo que o docker compose lê
#
# Copie para `docker/.env` e preencha. Ele NAO vai para o Git.
#
# Quase tudo tem default no `docker-compose.yml`, entao a stack sobe mesmo com
# este arquivo pela metade. O que falta nao quebra o boot: quebra uma
# funcionalidade, em silencio, na hora em que alguem for usar. Cada bloco abaixo
# diz o que para de funcionar sem ele.
# =============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Um container, varios bancos. Sem isto, nenhum servico conecta.
POSTGRES_DB=mora
POSTGRES_USER=admin
POSTGRES_PASSWORD=troque-pela-senha-do-postgres

# ── Consul ───────────────────────────────────────────────────────────────────
CONSUL_HOST=consul
CONSUL_PORT=8500

# ── Segredos compartilhados ──────────────────────────────────────────────────
# O auth-api emite os tokens; todos os outros servicos validam com ESTE mesmo
# valor. Divergir aqui faz cada servico recusar o token do outro com 401.
#
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# Assina o cookie de sessao do OAuth, e precisa ser DIFERENTE do JWT_SECRET:
# reutilizar faz as duas chaves cairem juntas se uma vazar.
SESSION_SECRET=troque-por-outra-chave-diferente-do-jwt

FRONTEND_URL=http://localhost:5173

# ── Conta administrativa inicial ─────────────────────────────────────────────
# Criada no primeiro boot do auth-api, so se ainda nao existir nenhum admin.
# Vazio = seed pulado, e nao ha como entrar no sistema pela primeira vez.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NOME=Admin

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Sem isto: "Entrar com Google" fica indisponivel. Login por e-mail e senha
# continua funcionando.
#
# 1. https://console.cloud.google.com/ -> criar projeto
# 2. Tela de consentimento OAuth + credenciais OAuth 2.0 (tipo Web)
# 3. URI de redirecionamento autorizada:
#    http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ── Gmail SMTP ───────────────────────────────────────────────────────────────
# Usado por auth-api (convite, esqueci a senha) e financeiro (aviso de fatura).
# Sem isto: o convite e criado no banco, mas o e-mail nao sai — e o morador
# nunca recebe o codigo para ativar a conta.
#
# 1. Ativar 2FA na conta Google
# 2. Criar App Password: https://myaccount.google.com/apppasswords
# 3. MAIL_PASS e a senha de app de 16 caracteres, nao a senha da conta
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Mora <seuemail@gmail.com>

# ── Asaas (gateway de cobranca) ──────────────────────────────────────────────
# Sem isto: o financeiro sobe e fecha competencia normalmente, mas as rotas de
# cobranca (PIX e boleto) respondem indisponivel.
#
# ATENCAO: a chave do Asaas comeca com `$`, e isso quebra em dois lugares.
#   - No PowerShell, entre aspas DUPLAS, `$aact_...` vira variavel inexistente
#     e grava string vazia. Use aspas simples, ou edite num editor de texto.
#   - O Docker Compose tambem interpola: aqui o `$` precisa estar escapado como
#     `$$`. O Compose entrega um `$` literal ao container.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ── Credencial entre servicos ────────────────────────────────────────────────
# O fechamento de competencia do financeiro roda como JOB, sem usuario logado,
# e precisa publicar notificacao no comunicacao. JWT sintetico nao serve: o
# auth-api busca o usuario no banco, e nao existe usuario para um token forjado.
#
# Sem isto a rota interna responde 503 — fechada, nao aberta. O fechamento roda
# e apenas a notificacao deixa de sair.
#
# Qualquer string longa e aleatoria serve, desde que igual nos dois servicos.
SERVICO_TOKEN=
