# Chave da API do Gemini (Google AI Studio). Obrigatória para os dois usos de
# LLM: extração do contrato em PDF e explicação do score em português.
GEMINI_API_KEY=

# Opcional: fixa o modelo. Vazio = o serviço descobre o melhor disponível na
# conta desta chave, via GET /v1beta/models. Não chutamos nome de modelo.
GEMINI_MODEL=

# 1 = não toca a rede, só lê as respostas gravadas em fixtures/respostas_gemini.
# É o plano B da defesa: se a rede da sala falhar, a demonstração continua.
IA_OFFLINE=0

IA_PORT=8000

# Lembrete preventivo no sino do Mora (opcional). Sem estas três, o lembrete é
# gerado mas não enviado. SERVICO_TOKEN é o mesmo do docker/.env.
COMUNICACAO_URL=http://localhost:8087/api/comunicacao
SERVICO_TOKEN=
# Os dados deste serviço são sintéticos: na demonstração, o lembrete vai a um
# usuário real do seed (ex.: 4 e cond-parque-verde).
IA_DEMO_USUARIO_ID=
IA_DEMO_CONDOMINIO_ID=
