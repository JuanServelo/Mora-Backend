NODE_ENV=development
PORT=3001
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=auth_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=sua_senha
FRONTEND_URL=http://localhost:5173

# ── Segredos ─────────────────────────────────────────────────
# Gere cada um com um valor DIFERENTE:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=eS1uu7ElIG71rT+uEKPTmQaC0x5h40Q5PDXwlFfnbBbQdzBhPhknCUrqFUn+r/53
# Assina o cookie de sessão do OAuth. Distinta do JWT_SECRET — reutilizar faria
# as duas chaves caírem juntas se uma vazasse. Obrigatória em produção.
SESSION_SECRET=eS1uu7ElIG71rT+uEKPTmQaC0x5h40Q5PDXwlFfnbBbQdzBhPhknCUrqFUn+r/17

# Validade do token de acesso (ex.: 15m, 12h, 7d)
JWT_EXPIRES_IN=7d

# ── Conta administrativa inicial ─────────────────────────────
# Criada no primeiro boot, apenas se ainda não existir nenhum admin.
# Sem estas variáveis o seed é pulado (a senha não fica mais no código).
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NOME=Admin

# ── Google OAuth ─────────────────────────────────────────────
# 1. https://console.cloud.google.com/ → criar projeto
# 2. OAuth consent screen + credenciais OAuth 2.0 (Web)
# 3. Redirect URI autorizada: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=570056074846-8g382ic7fpmom69kpr6uq0gpr6jj0vj6.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ── Gmail SMTP (convites + esqueci senha) ────────────────────
# 1. Ativar 2FA na conta Google
# 2. App Password: https://myaccount.google.com/apppasswords
# 3. Preencher com e-mail real e app password (16 caracteres)
MAIL_USER=mora.app100@gmail.com
MAIL_PASS=csutvnovcbtdxvhb
MAIL_FROM=Mora <mora.app100@gmail.com>

# Portaria service (validação de unidades — opcional)
PORTARIA_SERVICE_URL=http://localhost:8090

# Armazenamento de avatares (opcional)
STORAGE_PATH=
