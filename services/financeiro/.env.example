NODE_ENV=development
PORT=3004

# Mesmo segredo do auth-api: e ele quem emite os tokens que este servico valida.
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

FRONTEND_URL=http://localhost:5173

# Banco proprio. Fora do Docker a porta publicada no host e a 5433.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=mora_financeiro
POSTGRES_USER=admin
POSTGRES_PASSWORD=troque-pela-senha-do-postgres

# Fontes consultadas
AUTH_API_URL=http://localhost:3001
PORTARIA_SERVICE_URL=http://localhost:8090
PLAN_SERVICE_URL=http://localhost:8093
COMUNICACAO_SERVICE_URL=http://localhost:8094
FONTE_TIMEOUT_MS=3000

# Gateway de pagamento (Asaas). Sem a chave o servico sobe, mas as rotas de
# cobranca respondem indisponivel em vez de estourar.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Envio de aviso de fatura por e-mail. Sem elas o servico sobe normalmente.
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Credencial apresentada ao comunicacao-service para publicar notificacao sem
# usuario logado. Precisa ser o mesmo valor do SERVICO_TOKEN de la.
SERVICO_TOKEN=
