NODE_ENV=development
PORT=3002

# Mesmo segredo do auth-api: é ele quem emite os tokens que este serviço valida.
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

FRONTEND_URL=http://localhost:5173

# Fontes consultadas
AUTH_API_URL=http://localhost:3001
PORTARIA_SERVICE_URL=http://localhost:8090
PLAN_SERVICE_URL=http://localhost:8093

# Tempo máximo de espera por fonte antes de marcá-la indisponível
FONTE_TIMEOUT_MS=3000
