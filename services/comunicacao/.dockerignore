# O `COPY . .` do Dockerfile leva tudo que nao estiver listado aqui.
#
# `.env` e o motivo principal: ele tem a senha real do Postgres e o
# SERVICO_TOKEN, e dentro da imagem o segredo viaja junto com ela. No container
# as variaveis vem do compose, entao o arquivo nem faz falta.
.env
.env.*
!.env.example

# O node_modules do host e instalado no Windows e sobrescreveria o que o
# `npm install` montou no alpine — inclusive binarios nativos da plataforma errada.
node_modules
npm-debug.log

# Nao servem em producao e so incham a imagem.
tests
scripts
