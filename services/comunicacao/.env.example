NODE_ENV=development
PORT=3003

# Mesmo segredo do auth-api: e ele quem emite os tokens que este servico valida.
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

FRONTEND_URL=http://localhost:5173

# Banco proprio. Fora do Docker a porta publicada no host e a 5433.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=mora_comunicacao
POSTGRES_USER=admin
POSTGRES_PASSWORD=troque-pela-senha-do-postgres

# Fontes consultadas. Os avisos continuam no portaria; so a leitura nasce aqui.
AUTH_API_URL=http://localhost:3001
PORTARIA_SERVICE_URL=http://localhost:8090
FONTE_TIMEOUT_MS=3000

# Credencial que outro servico apresenta para publicar notificacao sem usuario
# logado — o caso e o fechamento de competencia do financeiro, que roda por job.
# Sem ela definida, /api/comunicacao/interno responde 503 em vez de ficar aberta.
SERVICO_TOKEN=
